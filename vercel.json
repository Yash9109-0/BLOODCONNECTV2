{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "AI_PROVIDER": "auto",
    "OPENROUTER_MODEL": "google/gemini-2.0-flash-exp:free"
  }
}
